#!/usr/bin/env zsh
# agency — setup and maintenance for the ~/.agents portable agent setup.
#
# The repo is the single source of truth. Generic directories (agents/,
# commands/, skills/) hold tool-agnostic content; each harness gets a mapping
# from those into the locations it discovers. opencode discovers skills/
# natively, so only agents/ and commands/ need links.

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
REPO="${SCRIPT_DIR:h}"

OPENCODE_DIR="${HOME}/.config/opencode"

usage() {
  print "usage: agency <install|status> <harness>"
  print "       agency notes <init|report|stale|lint|format|expire> [args]"
  print ""
  print "  install  create missing mappings for a harness (idempotent; never clobbers real files)"
  print "  status   report each mapping for a harness: linked, drifted, conflict, or missing"
  print "  notes    notes tooling, run from the project root whose .agent-notes/ you mean:"
  print "           report | stale [days] | lint | format |"
  print "           expire [days]          list sessions/ docs older than days (default 30)"
  print "           expire -- <file>...    delete exactly those files (must be inside sessions/)"
  print ""
  print "harnesses: opencode"
}

link_state() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    if [[ "${dst:A}" == "${src:A}" ]]; then
      print linked
    else
      print drifted
    fi
  elif [[ -e "$dst" ]]; then
    print conflict
  else
    print missing
  fi
}

# Apply or report a links table ("src:dst" elements). mode: install|status
run_links() {
  local mode="$1" rc=0 state pair src dst
  shift
  for pair in "$@"; do
    src="${pair%%:*}"
    dst="${pair##*:}"
    state="$(link_state "$src" "$dst")"
    if [[ "$mode" == status ]]; then
      printf '%-9s %s\n' "$state" "$dst"
      [[ "$state" == linked || "$state" == missing ]] || rc=1
      continue
    fi
    case "$state" in
      linked)
        print "ok       $dst"
        ;;
      drifted)
        print "drift    $dst -> $(readlink "$dst") (expected $src)"
        rc=1
        ;;
      conflict)
        print "SKIP     $dst exists and is not a symlink; refusing to clobber"
        rc=1
        ;;
      missing)
        mkdir -p "${dst:h}"
        ln -s "$src" "$dst"
        print "linked   $dst -> $src"
        ;;
    esac
  done
  return "$rc"
}

# --- harnesses ---------------------------------------------------------------

harness_opencode() {
  local mode="$1" rc=0
  run_links "$mode" \
    "$REPO/agents:$OPENCODE_DIR/agents" \
    "$REPO/commands:$OPENCODE_DIR/commands" || rc=1
  if [[ -d "$REPO/skills" ]]; then
    if [[ "$mode" == status ]]; then
      printf '%-9s %s\n' "ok" "$REPO/skills (native)"
    else
      print "ok       $REPO/skills (native discovery, no link needed)"
    fi
  else
    print "MISSING  $REPO/skills"
    rc=1
  fi
  return "$rc"
}

# --- tools on PATH -----------------------------------------------------------

# Tools installed onto PATH for every harness, not harness-specific mappings.
# `$HOME/.local/bin` — the XDG-standard location for user executables — must be
# on PATH (add it in your shell rc if not).
tools_links() {
  local mode="$1"
  run_links "$mode" \
    "$REPO/bin/agency:$HOME/.local/bin/agency" || return 1
  return 0
}

# --- dispatch ----------------------------------------------------------------

cmd="${1:-}"
harness="${2:-}"

case "$cmd" in
  install|status) ;;
  notes)
    shift
    exec ruby "$REPO/bin/notes" "$@"
    ;;
  help|-h|--help)
    usage
    exit 0
    ;;
  *)
    print "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac

rc=0
tools_links "$cmd" || rc=1
case "$harness" in
  opencode) harness_opencode "$cmd" || rc=1 ;;
  *)
    print "unknown harness: $harness" >&2
    usage >&2
    exit 2
    ;;
esac
exit "$rc"